<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <!-- Scanline overlay (Alien Green) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F39FF14"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glVertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <!-- Title on the Left -->
    <LinearLayout
        android:id="@+id/titleBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/glVertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOID"
            android:textColor="@color/alien_green"
            android:textSize="80sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:shadowColor="@color/alien_green"
            android:shadowRadius="25"
            android:shadowDx="0"
            android:shadowDy="0"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESIRA"
            android:textColor="@color/alien_cyan"
            android:textSize="32sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.4"
            android:shadowColor="@color/alien_cyan"
            android:shadowRadius="15"
            android:shadowDx="0"
            android:shadowDy="0"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◈ XENOS INFILTRATION ◈"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- Menu Card on the Right -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/glVertical"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/cardMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_cyberpunk_card"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="☣  INITIATE"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textColor="@color/alien_green"
                app:backgroundTint="#0A0F1E"
                app:strokeColor="@color/alien_green"
                app:strokeWidth="2dp"
                app:cornerRadius="4dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAvatar"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="👤 BIOMASS"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="@color/alien_cyan"
                    app:backgroundTint="#0A0F1E"
                    app:strokeColor="@color/alien_cyan"
                    app:strokeWidth="2dp"
                    app:cornerRadius="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpgrades"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="🧬 MUTATIONS"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="@color/alien_purple"
                    app:backgroundTint="#0A0F1E"
                    app:strokeColor="@color/alien_purple"
                    app:strokeWidth="2dp"
                    app:cornerRadius="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="⚙ CALIB"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#0A0F1E"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="2dp"
                    app:cornerRadius="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheats"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="⌨ BYPASS"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#00FFFF"
                    app:backgroundTint="#0A0F1E"
                    app:strokeColor="#00FFFF"
                    app:strokeWidth="2dp"
                    app:cornerRadius="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrestige"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="☢ RESET"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#FF8800"
                    app:backgroundTint="#0A0F1E"
                    app:strokeColor="#FF8800"
                    app:strokeWidth="2dp"
                    app:cornerRadius="4dp"
                    android:layout_marginEnd="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuit"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="✕ ABORT"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#FF4444"
                    app:backgroundTint="#0A0F1E"
                    app:strokeColor="#FF4444"
                    app:strokeWidth="2dp"
                    app:cornerRadius="4dp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Best Score -->
    <TextView
        android:id="@+id/tvBestScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HIGHEST BIOMASS: 0"
        android:textColor="#446644"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
